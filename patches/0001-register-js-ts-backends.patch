 /* check_options - check user-specified options */
 
+/* Whether a prefix can stand in the name a back end binds its scanner to. */
+static bool prefix_names_a_binding (const char *prefix)
+{
+	const char *cp;
+
+	if (prefix == NULL || *prefix == '\0')
+		return false;
+
+	/* No $: the name is built by m4, which reads $1 in a macro body as an
+	 * argument and would drop it.
+	 */
+	for (cp = prefix; *cp != '\0'; cp++) {
+		if (isalpha ((unsigned char) *cp) || *cp == '_')
+			continue;
+		if (cp > prefix && isdigit ((unsigned char) *cp))
+			continue;
+		return false;
+	}
+	return true;
+}
