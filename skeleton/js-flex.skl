      var pair = 0x10000 + ((code - 0xd800) << 10) + (text.charCodeAt(++index) - 0xdc00);
      bytes += String.fromCharCode(0xf0 | (pair >> 18), 0x80 | ((pair >> 12) & 0x3f),
